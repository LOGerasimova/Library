@model PagedResult<BookSearchResultDto>
@{
    ViewData["Title"] = "Книги";
    var search = ViewData["SearchRequest"] as SearchBooksRequest ?? new SearchBooksRequest();
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize));
    var year = search.YearOfPublication;
}

<section class="page-heading">
    <div>
        <h1>Книги</h1>
        <p>Поиск по названию, автору и содержанию оглавления.</p>
    </div>
</section>

<partial name="_SearchFormPartial" model="search" />

<p class="result-count">Найдено: @Model.TotalCount</p>

@if (Model.Items.Count == 0)
{
    <div class="empty-state">Книги не найдены. Измените условия поиска или добавьте новую запись.</div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Автор</th>
                    <th>Год</th>
                    <th>Совпадение в оглавлении</th>
                    <th aria-label="Действия"></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var book in Model.Items)
            {
                <tr>
                    <td>@book.Id</td>
                    <td><a asp-action="Details" asp-route-bookId="@book.Id">@book.Title</a></td>
                    <td>@book.Author</td>
                    <td>@book.YearOfPublication.Year</td>
                    <td>@(book.MatchedInToc ? book.TocSnippet : "—")</td>
                    <td class="row-actions">
                        <a asp-action="Edit" asp-route-bookId="@book.Id">Изменить</a>
                        <a class="danger-link" asp-action="Delete" asp-route-bookId="@book.Id">Удалить</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav class="pagination" aria-label="Страницы списка книг">
            @if (Model.PageNumber > 1)
            {
                <a asp-route-id="@search.Id" asp-route-title="@search.Title" asp-route-author="@search.Author"
                   asp-route-yearOfPublication="@year" asp-route-tocKeyword="@search.TocKeyword"
                   asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">← Назад</a>
            }
            <span>Страница @Model.PageNumber из @totalPages</span>
            @if (Model.PageNumber < totalPages)
            {
                <a asp-route-id="@search.Id" asp-route-title="@search.Title" asp-route-author="@search.Author"
                   asp-route-yearOfPublication="@year" asp-route-tocKeyword="@search.TocKeyword"
                   asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">Вперёд →</a>
            }
        </nav>
    }
}
